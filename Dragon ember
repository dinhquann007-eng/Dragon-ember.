----------------------------------------------------------------

brightnessButton.MouseButton1Click:Connect(function()
	brightness += 1

	if brightness > 4 then
		brightness = 1
	end

	brightnessButton.Text = "ĐỘ SÁNG: " .. brightness

	if not enabled then
		return
	end

	for object in pairs(processed) do
		if object and object.Parent then
			applyEmber(object)
		else
			processed[object] = nil
		end
	end
end)

