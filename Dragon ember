----------------------------------------------------------------
-- QUẢN LÝ VFX
----------------------------------------------------------------

local originalValues = {}
local processed = {}

local function isVFX(object)
	return object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Beam")
end

local function saveOriginal(object)
	if originalValues[object] then
		return
	end

	if object:IsA("ParticleEmitter") or object:IsA("Trail") then
		originalValues[object] = {
			Color = object.Color,
			LightEmission = object.LightEmission,
		}
	elseif object:IsA("Beam") then
		originalValues[object] = {
			Color = object.Color,
			Brightness = object.Brightness,
		}
	end
end

local function applyEmber(object)
	if not enabled or not object.Parent or not isVFX(object) then
		return
	end

	saveOriginal(object)

	if object:IsA("ParticleEmitter") or object:IsA("Trail") then
		object.Color = emberSequence
		object.LightEmission = math.clamp(
			0.35 + brightness * 0.12,
			0,
			0.85
		)
	elseif object:IsA("Beam") then
		object.Color = emberSequence
		object.Brightness = math.clamp(brightness, 0, 4)
	end

	processed[object] = true
end

----------------------------------------------------------------
-- KHÔI PHỤC VFX
----------------------------------------------------------------

local function restoreVFX()
	for object, data in pairs(originalValues) do
		if object and object.Parent then
			if object:IsA("ParticleEmitter") or object:IsA("Trail") then
				object.Color = data.Color
				object.LightEmission = data.LightEmission
			elseif object:IsA("Beam") then
				object.Color = data.Color
				object.Brightness = data.Brightness
			end
		end
	end

	table.clear(processed)
end

----------------------------------------------------------------
-- QUÉT VFX
----------------------------------------------------------------

local function scanVFX()
	for _, object in ipairs(workspace:GetDescendants()) do
		if isVFX(object) then
			applyEmber(object)
		end
	end
end

----------------------------------------------------------------
-- PHÁT HIỆN VFX MỚI
----------------------------------------------------------------

workspace.DescendantAdded:Connect(function(object)
	if not enabled or not isVFX(object) then
		return
	end

	task.defer(function()
		if object.Parent and enabled then
			applyEmber(object)
		end
	end)
end)

----------------------------------------------------------------
-- KÉO LOGO VÀ CLICK
----------------------------------------------------------------

do
	local dragging = false
	local dragStart
	local startPosition
	local moved = false
	local activeInput

	logo.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			moved = false
			activeInput = input
			dragStart = input.Position
			startPosition = logo.Position
		end
	end)

	logo.InputEnded:Connect(function(input)
		if input == activeInput then
			dragging = false
			activeInput = nil

			if not moved then
				panel.Visible = not panel.Visible
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart

		if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
			moved = true
		end

		logo.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)
end

----------------------------------------------------------------
-- KÉO PANEL BẰNG HEADER
----------------------------------------------------------------

do
	local dragging = false
	local dragStart
	local startPosition

	dragHeader.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPosition = panel.Position
		end
	end)

	dragHeader.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart

		panel.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)
end

